{
  "name": "yofix",
  "version": "1.1.0",
  "description": "AI-powered visual issue detection and auto-fix for web applications",
  "scripts": {
    "postinstall": "playwright install chromium",
    "build": "npm run clean && npm run build:main",
    "build:main": "mkdir -p dist && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:sharp --external:playwright --external:firebase-admin --external:@google-cloud/firestore --external:@yofix/analyzer --external:@yofix/browser --external:@yofix/comparator --external:@yofix/storage --format=cjs --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:action": "act -j visual-test --secret-file .env.test",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rimraf dist",
    "release:patch": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major",
    "release": "./scripts/release.sh",
    "release:dev": "./scripts/release-dev.sh",
    "release:alpha": "./scripts/release-pre.sh alpha",
    "test:storage": "ts-node tests/test-storage-local.ts",
    "test:storage:ci": "ts-node tests/test-storage-integration.ts",
    "test:browser-agent": "jest src/browser-agent --passWithNoTests",
    "test:integration": "jest tests/integration --passWithNoTests"
  },
  "keywords": [
    "visual-testing",
    "auto-fix",
    "ai",
    "github-action",
    "visual-regression",
    "playwright",
    "yofix",
    "ui-testing",
    "automated-fixes",
    "claude-ai",
    "screenshot-testing"
  ],
  "author": {
    "name": "YoFix Team",
    "email": "support@yofix.dev",
    "url": "https://yofix.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yofix/yofix.git"
  },
  "bugs": {
    "url": "https://github.com/yofix/yofix/issues"
  },
  "homepage": "https://github.com/yofix/yofix#readme",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.20.0",
    "@aws-sdk/client-s3": "^3.478.0",
    "@aws-sdk/s3-request-presigner": "^3.478.0",
    "@playwright/test": "^1.41.2",
    "@types/js-yaml": "^4.0.9",
    "@yofix/analyzer": "^0.1.6",
    "@yofix/browser": "^1.0.11",
    "@yofix/comparator": "^1.0.2",
    "@yofix/storage": "^1.0.5",
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.0.0",
    "glob": "^11.0.3",
    "js-yaml": "^4.1.0",
    "playwright": "^1.41.2",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^18.19.39",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "esbuild": "^0.25.8",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "action.yml",
    "README.md"
  ],
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}

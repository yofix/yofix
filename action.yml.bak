name: 'yofix'
description: 'AI-powered visual issue detection and auto-fix for web applications'
author: 'YoFix'

branding:
  icon: 'activity'
  color: 'purple'

inputs:
  preview-url:
    description: 'Firebase preview URL (e.g., https://project--pr-123-app.web.app)'
    required: true
  
  github-token:
    description: 'GitHub token for posting PR comments'
    required: true
  
  claude-api-key:
    description: 'Claude API key for intelligent route analysis'
    required: true

  claude-model:
    description: 'Claude model to use (e.g., claude-sonnet-4-5-20250929, claude-sonnet-4-20250514)'
    required: true

  # Baseline Configuration
  production-url:
    description: 'Production or staging URL for creating visual baselines (e.g., https://myapp.com)'
    required: false
  
  # Storage Configuration
  storage-provider:
    description: 'Storage provider: firebase, s3, or github'
    required: false
    default: 'firebase'
  
  # Firebase Storage
  firebase-credentials:
    description: 'Base64 encoded Firebase service account JSON'
    required: false
  
  storage-bucket:
    description: 'Firebase Storage bucket name'
    required: false

  storage-directory:
    description: 'Base directory in storage for all YoFix files (baselines, screenshots, diffs, cache). Default: yofix'
    required: false
    default: 'yofix'

  # S3 Storage
  s3-bucket:
    description: 'AWS S3 bucket name'
    required: false
  
  aws-region:
    description: 'AWS region for S3 bucket'
    required: false
    default: 'us-east-1'
  
  aws-access-key-id:
    description: 'AWS access key ID (uses default credentials if not provided)'
    required: false
  
  aws-secret-access-key:
    description: 'AWS secret access key (uses default credentials if not provided)'
    required: false

  firebase-target:
    description: 'Firebase hosting target (auto-detected from preview URL if not provided)'
    required: false
  
  build-system:
    description: 'Build system: vite or react (auto-detected from output folder if not provided)'
    required: false
    default: ''
  
  test-timeout:
    description: 'Maximum time for tests to run (e.g., 5m, 300s)'
    required: false
    default: '5m'
  
  cleanup-days:
    description: 'Days to keep old screenshots before cleanup'
    required: false
    default: '30'
  
  viewports:
    description: 'Comma-separated viewport sizes (e.g., 1920x1080,768x1024,375x667)'
    required: false
    default: '1920x1080,768x1024,375x667'

  full-page:
    description: 'Capture full-page height (true) or fixed viewport height (false). When true, uses viewport width but captures entire page height.'
    required: false
    default: 'true'

  comparison-threshold:
    description: 'Pixel difference threshold for baseline comparison (0-1, default: 0.01 = 1%)'
    required: false
    default: '0.01'
  
  max-routes:
    description: 'Maximum number of routes to test'
    required: false
    default: '10'
  
  auth-email:
    description: 'Email for authentication (if app requires login)'
    required: false
  
  auth-password:
    description: 'Password for authentication (if app requires login)'
    required: false
  
  auth-login-url:
    description: 'Login page URL path (e.g., /login)'
    required: false
    default: '/login'

  clear-cache:
    description: 'Clear route analysis cache before running'
    required: false
    default: 'false'

  update-baselines-on-merge:
    description: 'Update baselines after PR merge - tuple format: ["branch", "enabled"] (e.g., ["main", "true"])'
    required: false
    default: '["", "false"]'

outputs:
  status:
    description: 'Test execution status'
  
  summary-url:
    description: 'URL to the test results summary'
  
  firebase-target:
    description: 'Detected Firebase hosting target'
  
  build-system:
    description: 'Detected build system'

runs:
  using: 'composite'
  steps:
    # Step 1: Cache Playwright browsers
    - name: 📦 Cache Playwright Browsers
      uses: actions/cache@v4
      id: playwright-cache
      with:
        path: |
          ~/.cache/ms-playwright
          ~/playwright-deps
        key: playwright-browsers-${{ runner.os }}-1.54.1-v2
        restore-keys: |
          playwright-browsers-${{ runner.os }}-1.54.1-
          playwright-browsers-${{ runner.os }}-
    
    # Step 2: Setup Playwright
    - name: 🎭 Setup Playwright Environment
      shell: bash
      run: |
        echo "::group::Playwright Setup"
        cd ${{ github.action_path }}

        if [ "${{ steps.playwright-cache.outputs.cache-hit }}" != "true" ]; then
          echo "📦 Installing Playwright browsers (cache miss)..."

          # Install Playwright with browsers and dependencies
          npx -y playwright@1.54.1 install chromium --with-deps

          # Save installed dependencies list for caching
          mkdir -p ~/playwright-deps
          dpkg -l > ~/playwright-deps/installed-packages.txt

          echo "✅ Playwright browsers and dependencies installed"
        else
          echo "🚀 Using cached Playwright browsers"

          # Just ensure system dependencies are present (fast operation)
          # This handles cases where the runner image has changed
          npx -y playwright@1.54.1 install-deps chromium || true
        fi
        echo "::endgroup::"
    
    # Step 3: Install runtime dependencies
    - name: 📦 Install YoFix Dependencies
      shell: bash
      run: |
        echo "::group::YoFix Dependencies Installation"
        echo "📦 Installing runtime dependencies..."
        cd ${{ github.action_path }}

        # Install only production dependencies including all externalized modules
        echo "Running: npm install --production --ignore-scripts"
        npm install --production --ignore-scripts

        # Rebuild native modules to ensure correct binaries
        echo "Rebuilding native modules..."
        npm rebuild

        echo "✅ Runtime dependencies installed"
        echo "::endgroup::"

    # Step 4: Initialize YoFix
    - name: 📋 Initialize YoFix
      id: initialize
      shell: bash
      run: |
        echo "🚀 Initializing YoFix step-based workflow..."
        node ${{ github.action_path }}/dist/steps/0-initialize.step.js
      env:
        INPUT_PREVIEW_URL: ${{ inputs.preview-url }}
        INPUT_GITHUB_TOKEN: ${{ inputs.github-token }}
        INPUT_CLAUDE_API_KEY: ${{ inputs.claude-api-key }}
        INPUT_CLAUDE_MODEL: ${{ inputs.claude-model }}
        INPUT_PRODUCTION_URL: ${{ inputs.production-url }}
        INPUT_STORAGE_PROVIDER: ${{ inputs.storage-provider }}
        INPUT_FIREBASE_CREDENTIALS: ${{ inputs.firebase-credentials }}
        INPUT_STORAGE_BUCKET: ${{ inputs.storage-bucket }}
        INPUT_S3_BUCKET: ${{ inputs.s3-bucket }}
        INPUT_AWS_REGION: ${{ inputs.aws-region }}
        INPUT_AWS_ACCESS_KEY_ID: ${{ inputs.aws-access-key-id }}
        INPUT_AWS_SECRET_ACCESS_KEY: ${{ inputs.aws-secret-access-key }}
        INPUT_FIREBASE_TARGET: ${{ inputs.firebase-target }}
        INPUT_BUILD_SYSTEM: ${{ inputs.build-system }}
        INPUT_TEST_TIMEOUT: ${{ inputs.test-timeout }}
        INPUT_CLEANUP_DAYS: ${{ inputs.cleanup-days }}
        INPUT_VIEWPORTS: ${{ inputs.viewports }}
        INPUT_MAX_ROUTES: ${{ inputs.max-routes }}
        INPUT_AUTH_EMAIL: ${{ inputs.auth-email }}
        INPUT_AUTH_PASSWORD: ${{ inputs.auth-password }}
        INPUT_AUTH_LOGIN_URL: ${{ inputs.auth-login-url }}
        INPUT_CLEAR_CACHE: ${{ inputs.clear-cache }}

    # Step 5: Analyze Routes
    - name: 🔍 Find Impact Routes
      id: analyze-routes
      shell: bash
      run: |
        echo "🛰️ Analyzing route impacts using route-impact-analyzer..."
        node ${{ github.action_path }}/dist/steps/1-analyze-routes.step.js
      env:
        INPUT_PREVIEW-URL: ${{ inputs.preview-url }}
        INPUT_GITHUB-TOKEN: ${{ inputs.github-token }}
        INPUT_CLAUDE-API-KEY: ${{ inputs.claude-api-key }}
        INPUT_CLAUDE-MODEL: ${{ inputs.claude-model }}
        INPUT_CLEAR-CACHE: ${{ inputs.clear-cache }}

    # Step 6: Browse Routes
    - name: 🌐 Browse Impact Routes
      id: browse-routes
      shell: bash
      run: |
        echo "📸 Capturing screenshots for affected routes..."
        node ${{ github.action_path }}/dist/steps/2-browse-routes.step.js
      env:
        INPUT_PREVIEW-URL: ${{ inputs.preview-url }}
        INPUT_CLAUDE-API-KEY: ${{ inputs.claude-api-key }}
        INPUT_CLAUDE-MODEL: ${{ inputs.claude-model }}
        INPUT_VIEWPORTS: ${{ inputs.viewports }}
        INPUT_AUTH-EMAIL: ${{ inputs.auth-email }}
        INPUT_AUTH-PASSWORD: ${{ inputs.auth-password }}
        INPUT_AUTH-LOGIN-URL: ${{ inputs.auth-login-url }}
        INPUT_TEST-TIMEOUT: ${{ inputs.test-timeout }}

    # Step 6.5: Compare with Baselines
    - name: 🔍 Compare Screenshots with Baselines
      id: compare-baselines
      shell: bash
      run: |
        echo "📊 Comparing screenshots with stored baselines..."
        node ${{ github.action_path }}/dist/steps/2.5-compare-baselines.step.js
      env:
        INPUT_STORAGE-PROVIDER: ${{ inputs.storage-provider }}
        INPUT_FIREBASE-CREDENTIALS: ${{ inputs.firebase-credentials }}
        INPUT_STORAGE-BUCKET: ${{ inputs.storage-bucket }}
        INPUT_S3-BUCKET: ${{ inputs.s3-bucket }}
        INPUT_AWS-REGION: ${{ inputs.aws-region }}
        INPUT_AWS-ACCESS-KEY-ID: ${{ inputs.aws-access-key-id }}
        INPUT_AWS-SECRET-ACCESS-KEY: ${{ inputs.aws-secret-access-key }}
        INPUT_COMPARISON-THRESHOLD: ${{ inputs.comparison-threshold }}

    # Step 7: Upload Screenshots
    - name: ☁️ Upload Screenshots to Storage
      id: upload-storage
      shell: bash
      run: |
        echo "📤 Uploading screenshots to cloud storage..."
        node ${{ github.action_path }}/dist/steps/3-upload-storage.step.js
      env:
        INPUT_STORAGE-PROVIDER: ${{ inputs.storage-provider }}
        INPUT_FIREBASE-CREDENTIALS: ${{ inputs.firebase-credentials }}
        INPUT_STORAGE-BUCKET: ${{ inputs.storage-bucket }}
        INPUT_S3-BUCKET: ${{ inputs.s3-bucket }}
        INPUT_AWS-REGION: ${{ inputs.aws-region }}
        INPUT_AWS-ACCESS-KEY-ID: ${{ inputs.aws-access-key-id }}
        INPUT_AWS-SECRET-ACCESS-KEY: ${{ inputs.aws-secret-access-key }}

    # Step 8: Post Results
    - name: 💬 Post GitHub Comment
      id: post-results
      if: always()
      shell: bash
      run: |
        echo "📝 Posting results to GitHub PR..."
        node ${{ github.action_path }}/dist/steps/4-post-results.step.js
      env:
        INPUT_GITHUB-TOKEN: ${{ inputs.github-token }}

    # Step 8.5: Update Baselines (Post-Merge Only)
    - name: 🔄 Update Baselines
      id: update-baselines
      if: always()
      shell: bash
      run: |
        echo "🔄 Checking baseline update configuration..."
        node ${{ github.action_path }}/dist/steps/5-update-baselines.step.js
      env:
        INPUT_STORAGE-PROVIDER: ${{ inputs.storage-provider }}
        INPUT_FIREBASE-CREDENTIALS: ${{ inputs.firebase-credentials }}
        INPUT_STORAGE-BUCKET: ${{ inputs.storage-bucket }}
        INPUT_S3-BUCKET: ${{ inputs.s3-bucket }}
        INPUT_AWS-REGION: ${{ inputs.aws-region }}
        INPUT_AWS-ACCESS-KEY-ID: ${{ inputs.aws-access-key-id }}
        INPUT_AWS-SECRET-ACCESS-KEY: ${{ inputs.aws-secret-access-key }}
        INPUT_UPDATE-BASELINES-ON-MERGE: ${{ inputs.update-baselines-on-merge }}

    # Step 9: Generate Test Summary
    - name: 📊 Generate Test Summary
      if: always()
      shell: bash
      run: |
        echo "::group::Test Summary"
        echo "## YoFix Visual Test Summary" >> $GITHUB_STEP_SUMMARY
        echo "" >> $GITHUB_STEP_SUMMARY

        if [ "${{ steps.post-results.outputs.success }}" = "true" ]; then
          echo "✅ **Status:** All visual tests passed" >> $GITHUB_STEP_SUMMARY
        else
          echo "❌ **Status:** Visual tests completed with issues" >> $GITHUB_STEP_SUMMARY
        fi

        echo "" >> $GITHUB_STEP_SUMMARY
        echo "### Test Configuration" >> $GITHUB_STEP_SUMMARY
        echo "- **Preview URL:** ${{ inputs.preview-url }}" >> $GITHUB_STEP_SUMMARY
        echo "- **Routes Tested:** ${{ steps.analyze-routes.outputs.routes-count }}" >> $GITHUB_STEP_SUMMARY
        echo "- **Viewports:** ${{ inputs.viewports }}" >> $GITHUB_STEP_SUMMARY
        echo "- **Max Routes:** ${{ inputs.max-routes }}" >> $GITHUB_STEP_SUMMARY
        echo "- **Storage Provider:** ${{ inputs.storage-provider }}" >> $GITHUB_STEP_SUMMARY

        if [ -n "${{ inputs.auth-email }}" ]; then
          echo "- **Authentication:** Enabled" >> $GITHUB_STEP_SUMMARY
        else
          echo "- **Authentication:** Disabled" >> $GITHUB_STEP_SUMMARY
        fi

        if [ -n "${{ steps.post-results.outputs.duration-seconds }}" ]; then
          echo "- **Duration:** ${{ steps.post-results.outputs.duration-seconds }}s" >> $GITHUB_STEP_SUMMARY
        fi

        echo "::endgroup::"